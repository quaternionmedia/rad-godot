# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot-specific text formats that should never be diffed as binary.
*.gd text
*.tscn text
*.tres text
*.godot text

# Native binaries shipped with addons — never touch line endings.
*.dll binary
*.so binary
*.dylib binary
*.lib binary
*.exp binary

# Common binary asset types.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.import text
